---
import '@/styles/global.css';
import MetaTags from '@/components/MetaTags.astro';
import FooterWidgetRenderer from '@/components/FooterWidgetRenderer.astro';
import { fetchKennel, fetchManifest } from '@/lib/wetnose';
import type { SiteManifestPageStub } from '@/lib/template-kit';

interface Props {
  title: string;
  description?: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const buildId = import.meta.env.WETNOSE_BUILD_ID ?? 'dev';
const buildTime = import.meta.env.WETNOSE_BUILD_TIME ?? new Date().toISOString();

let logoUrl: string | null = null;
let kennelName = 'Kennel';
let cmsPages: SiteManifestPageStub[] = [];
let footerWidgets: any[] = [];
try {
  const [kennel, manifest] = await Promise.all([
    fetchKennel(),
    fetchManifest(),
  ]);
  logoUrl = kennel.logoUrl;
  kennelName = kennel.name || kennelName;
  cmsPages = manifest.pages;
  footerWidgets = manifest.site?.footerWidgets ?? [];
} catch (_) {
  // fall back to empty nav + text logo
}

const fullTitle = title.includes(kennelName) ? title : `${title} — ${kennelName}`;
const resolvedDescription = description ?? `${kennelName} — kennel website`;
const jsonLdArr = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const reserved = new Set(['dogs', 'litters', 'contact', 'screening', '404']);
const visiblePages = cmsPages.filter((p) => !reserved.has(p.slug));
const roots = visiblePages.filter((p) => p.parentId === null);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MetaTags title={fullTitle} description={resolvedDescription} ogImage={ogImage} ogType={ogType} />
    <meta name="x-wetnose-build-id" content={buildId} />
    <meta name="x-wetnose-build-time" content={buildTime} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {jsonLdArr.map(ld => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-background">
    <header class="sticky top-0 z-50 bg-background border-b border-stone-200/60">
      <!-- Centered logo row -->
      <div class="flex justify-center py-6 md:py-8">
        <a href="/" class="hover:opacity-80 transition-opacity">
          {logoUrl ? (
            <img src={logoUrl} alt={kennelName} class="h-16 md:h-20 w-auto object-contain" />
          ) : (
            <div class="text-3xl md:text-4xl font-serif font-bold text-primary">{kennelName}</div>
          )}
        </a>
      </div>

      <!-- Thin nav row -->
      <nav class="flex justify-center items-center gap-1 py-3 px-4 border-t border-stone-200/60 flex-wrap">
        {roots.map((p) => (
          <>
            <a href={`/${p.slug}`} class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
              {p.title}
            </a>
            <span class="text-foreground/30 mx-1">·</span>
          </>
        ))}

        <a href="/dogs" class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
          Dogs
        </a>
        <span class="text-foreground/30 mx-1">·</span>

        <a href="/litters" class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
          Litters
        </a>
        <span class="text-foreground/30 mx-1">·</span>

        <a href="/contact" class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
          Contact
        </a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-stone-200/60 bg-background mt-20">
      {footerWidgets.length > 0 ? (
        <FooterWidgetRenderer widgets={footerWidgets} />
      ) : (
        <div class="py-20 px-6">
          <div class="max-w-2xl mx-auto text-center">
            <!-- About copy -->
            <p class="text-base leading-relaxed text-foreground/80 mb-12">
              {resolvedDescription}
            </p>

            <!-- Thin inline nav row -->
            <div class="flex justify-center items-center gap-2 mb-8 flex-wrap text-sm text-foreground/70">
              {roots.map((p, i) => (
                <>
                  <a href={`/${p.slug}`} class="hover:text-primary transition-colors">{p.title}</a>
                  {i < roots.length - 1 && <span class="text-foreground/30">·</span>}
                </>
              ))}
              {roots.length > 0 && <span class="text-foreground/30">·</span>}
              <a href="/dogs" class="hover:text-primary transition-colors">Dogs</a>
              <span class="text-foreground/30">·</span>
              <a href="/litters" class="hover:text-primary transition-colors">Litters</a>
              <span class="text-foreground/30">·</span>
              <a href="/contact" class="hover:text-primary transition-colors">Contact</a>
            </div>

            <!-- Copyright -->
            <p class="text-xs text-foreground/40 pt-4 border-t border-stone-200/60">
              &copy; {new Date().getFullYear()} {kennelName}. All rights reserved.
            </p>
          </div>
        </div>
      )}
    </footer>
  </body>
</html>
