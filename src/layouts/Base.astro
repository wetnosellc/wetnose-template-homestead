---
import '@/styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import MetaTags from '@/components/MetaTags.astro';
import FooterWidgetRenderer from '@/components/FooterWidgetRenderer.astro';
import { safeGetManifest } from '@/lib/client';
import type { Widget as WidgetInstance } from '@wetnosellc/template-kit';

interface Props {
  title: string;
  description?: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const buildId = import.meta.env.WETNOSE_BUILD_ID ?? 'dev';
const buildTime = import.meta.env.WETNOSE_BUILD_TIME ?? new Date().toISOString();

const manifest = await safeGetManifest();
const kennelName = manifest?.kennelName ?? 'Kennel';
const logoUrl = manifest?.logoUrl ?? null;
const cmsPages = manifest?.pages ?? [];
const footerWidgets: WidgetInstance[] = (manifest?.themeTokens?.footerWidgets as WidgetInstance[]) ?? [];

const fullTitle = title.includes(kennelName) ? title : `${title} — ${kennelName}`;
const resolvedDescription = description ?? `${kennelName} — kennel website`;
const jsonLdArr = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const reserved = new Set(['dogs', 'litters', 'contact', 'screening', '404']);
const visiblePages = cmsPages.filter((p) => p.slug && !reserved.has(p.slug));
const roots = visiblePages.filter((p) => !p.parentId);
const childrenByParent = new Map<string, typeof cmsPages>();
for (const p of visiblePages) {
  if (p.parentId) {
    const list = childrenByParent.get(p.parentId) ?? [];
    list.push(p);
    childrenByParent.set(p.parentId, list);
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MetaTags title={fullTitle} description={resolvedDescription} ogImage={ogImage} ogType={ogType} />
    <meta name="x-wetnose-build-id" content={buildId} />
    <meta name="x-wetnose-build-time" content={buildTime} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <ViewTransitions />
    {jsonLdArr.map(ld => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col bg-background">
    <header class="sticky top-0 z-50 bg-background border-b border-stone-200/60">
      <!-- Centered logo row -->
      <div class="flex justify-center py-6 md:py-8">
        <a href="/" class="hover:opacity-80 transition-opacity">
          {logoUrl ? (
            <img src={logoUrl} alt={kennelName} class="h-16 md:h-20 w-auto object-contain" />
          ) : (
            <div class="text-3xl md:text-4xl font-serif font-bold text-primary">{kennelName}</div>
          )}
        </a>
      </div>

      <!-- Thin nav row -->
      <nav class="flex justify-center items-center gap-1 py-3 px-4 border-t border-stone-200/60 flex-wrap relative">
        {roots.map((p, idx) => {
          const kids = childrenByParent.get(p.id) ?? [];
          return (
            <>
              {kids.length > 0 ? (
                <div class="relative group">
                  <button class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors flex items-center gap-1">
                    {p.title}
                    <svg class="w-3 h-3 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div class="absolute left-0 top-full pt-1 w-40 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150 z-10">
                    <div class="bg-background border border-stone-200/60 rounded shadow-lg py-2">
                      {kids.map((c) => (
                        <a href={`/${c.slug}`} class="block px-4 py-2 text-sm text-foreground/80 hover:text-primary hover:bg-primary/5 transition-colors">
                          {c.title}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <a href={`/${p.slug}`} class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
                  {p.title}
                </a>
              )}
              {idx < roots.length - 1 && <span class="text-foreground/30 mx-1">·</span>}
            </>
          );
        })}

        {roots.length > 0 && <span class="text-foreground/30 mx-1">·</span>}

        <a href="/dogs" class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
          Dogs
        </a>
        <span class="text-foreground/30 mx-1">·</span>

        <a href="/litters" class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
          Litters
        </a>
        <span class="text-foreground/30 mx-1">·</span>

        <a href="/contact" class="text-sm text-foreground/80 hover:text-primary underline-offset-4 hover:underline transition-colors">
          Contact
        </a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-stone-200/60 bg-background mt-20">
      {footerWidgets.length > 0 ? (
        <FooterWidgetRenderer widgets={footerWidgets} />
      ) : (
        <div class="py-20 px-6">
          <div class="max-w-2xl mx-auto text-center">
            <!-- About copy -->
            <p class="text-base leading-relaxed text-foreground/80 mb-12">
              {resolvedDescription}
            </p>

            <!-- Thin inline nav row -->
            <div class="flex justify-center items-center gap-2 mb-8 flex-wrap text-sm text-foreground/70">
              {roots.map((p, i) => (
                <>
                  <a href={`/${p.slug}`} class="hover:text-primary transition-colors">{p.title}</a>
                  {i < roots.length - 1 && <span class="text-foreground/30">·</span>}
                </>
              ))}
              {roots.length > 0 && <span class="text-foreground/30">·</span>}
              <a href="/dogs" class="hover:text-primary transition-colors">Dogs</a>
              <span class="text-foreground/30">·</span>
              <a href="/litters" class="hover:text-primary transition-colors">Litters</a>
              <span class="text-foreground/30">·</span>
              <a href="/contact" class="hover:text-primary transition-colors">Contact</a>
            </div>

            {/* Child pages, if any */}
            {Array.from(childrenByParent.values()).flat().length > 0 && (
              <div class="flex justify-center items-center gap-2 flex-wrap text-xs text-foreground/60 mb-8">
                {Array.from(childrenByParent.entries()).map(([parentId, children]) => (
                  children.map((c, idx) => (
                    <>
                      <a href={`/${c.slug}`} class="hover:text-primary transition-colors">{c.title}</a>
                      {idx < children.length - 1 && <span class="text-foreground/30">·</span>}
                    </>
                  ))
                ))}
              </div>
            )}

            <!-- Copyright -->
            <p class="text-xs text-foreground/40 pt-4 border-t border-stone-200/60">
              &copy; {new Date().getFullYear()} {kennelName}. All rights reserved.
            </p>
          </div>
        </div>
      )}
    </footer>
  </body>
</html>
