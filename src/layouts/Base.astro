---
import '@/styles/global.css';
import MetaTags from '@/components/MetaTags.astro';
import FooterWidgetRenderer from '@/components/FooterWidgetRenderer.astro';
import { fetchKennel, fetchManifest } from '@/lib/wetnose';
import type { SiteManifestPageStub } from '@/lib/template-kit';

interface Props {
  title: string;
  description?: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const buildId = import.meta.env.WETNOSE_BUILD_ID ?? 'dev';
const buildTime = import.meta.env.WETNOSE_BUILD_TIME ?? new Date().toISOString();

let logoUrl: string | null = null;
let kennelName = 'Kennel';
let cmsPages: SiteManifestPageStub[] = [];
let footerWidgets: any[] = [];
try {
  const [kennel, manifest] = await Promise.all([
    fetchKennel(),
    fetchManifest(),
  ]);
  logoUrl = kennel.logoUrl;
  kennelName = kennel.name || kennelName;
  cmsPages = manifest.pages;
  footerWidgets = manifest.site?.footerWidgets ?? [];
} catch (_) {
  // fall back to empty nav + text logo
}

const fullTitle = title.includes(kennelName) ? title : `${title} — ${kennelName}`;
const resolvedDescription = description ?? `${kennelName} — kennel website`;
const jsonLdArr = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// Nav rendering: top-level CMS pages whose showInNav slot isn't false.
// Children (parentId !== null) render as a dropdown under their parent.
// Reserved slugs (owned by built-in template routes) are dropped so they don't
// shadow the Dogs/Litters/Contact entries below.
const reserved = new Set(['dogs', 'litters', 'contact', 'screening', '404']);
const visiblePages = cmsPages.filter((p) => !reserved.has(p.slug));

const roots = visiblePages.filter((p) => p.parentId === null);
const childrenByParent = new Map<string, SiteManifestPageStub[]>();
for (const p of visiblePages) {
  if (p.parentId) {
    const list = childrenByParent.get(p.parentId) ?? [];
    list.push(p);
    childrenByParent.set(p.parentId, list);
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MetaTags title={fullTitle} description={resolvedDescription} ogImage={ogImage} ogType={ogType} />
    <meta name="x-wetnose-build-id" content={buildId} />
    <meta name="x-wetnose-build-time" content={buildTime} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {jsonLdArr.map(ld => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-card/80 backdrop-blur-sm shadow-sm border-b border-border">
      <div class="mx-auto max-w-7xl px-4">
        <div class="flex items-center justify-between py-2">
          <!-- Logo -->
          <a href="/" class="hover:opacity-80 transition-opacity">
            <img src={logoUrl ?? '/logo.webp'} alt={kennelName} class="h-20 w-auto object-contain" />
          </a>

          <!-- Desktop nav -->
          <nav class="hidden md:flex items-center gap-1">
            {roots.map((p) => {
              const kids = childrenByParent.get(p.id) ?? [];
              if (kids.length === 0) {
                return (
                  <a href={`/${p.slug}`} class="px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                    {p.title}
                  </a>
                );
              }
              return (
                <div class="relative group">
                  <a href={`/${p.slug}`} class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                    {p.title}
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </a>
                  <div class="absolute left-0 top-full pt-1 w-52 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150">
                    <div class="bg-white border border-border rounded-lg shadow-lg py-1">
                      {kids.map((c) => (
                        <a href={`/${c.slug}`} class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">{c.title}</a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })}

            <!-- Dogs (built-in) -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                Dogs
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 w-44 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150">
                <div class="bg-white border border-border rounded-lg shadow-lg py-1">
                  <a href="/dogs#males" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Studs</a>
                  <a href="/dogs#females" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Dams</a>
                  <a href="/dogs#for-sale" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">For Sale</a>
                  <a href="/dogs#retired" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Retired</a>
                </div>
              </div>
            </div>

            <!-- Litters (built-in) -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                Litters
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 w-44 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150">
                <div class="bg-white border border-border rounded-lg shadow-lg py-1">
                  <a href="/litters#current" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Current</a>
                  <a href="/litters#upcoming" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Upcoming</a>
                  <a href="/litters#planned" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Planned</a>
                  <a href="/litters#past" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Past</a>
                </div>
              </div>
            </div>

            <a href="/contact" class="ml-2 px-4 py-2 text-sm font-medium bg-primary text-white rounded-md hover:bg-primary/90 transition-colors">
              Contact
            </a>
          </nav>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-md text-foreground hover:bg-secondary transition-colors"
            aria-label="Open menu"
          >
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white">
        <div class="px-4 py-3 space-y-1">
          {roots.map((p) => {
            const kids = childrenByParent.get(p.id) ?? [];
            if (kids.length === 0) {
              return (
                <a href={`/${p.slug}`} class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">{p.title}</a>
              );
            }
            return (
              <>
                <a href={`/${p.slug}`} class="block px-2 py-2 text-sm font-semibold text-foreground hover:text-primary transition-colors">{p.title}</a>
                {kids.map((c) => (
                  <a href={`/${c.slug}`} class="block px-4 py-2 text-sm text-foreground hover:text-primary transition-colors">{c.title}</a>
                ))}
              </>
            );
          })}

          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pt-3 pb-1">Dogs</p>
          <a href="/dogs#males" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Studs</a>
          <a href="/dogs#females" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Dams</a>
          <a href="/dogs#for-sale" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">For Sale</a>
          <a href="/dogs#retired" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Retired</a>

          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pt-3 pb-1">Litters</p>
          <a href="/litters#current" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Current</a>
          <a href="/litters#upcoming" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Upcoming</a>
          <a href="/litters#planned" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Planned</a>
          <a href="/litters#past" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Past</a>

          <div class="pt-3 pb-2">
            <a href="/contact" class="block w-full text-center px-4 py-2 text-sm font-medium bg-primary text-white rounded-md hover:bg-primary/90 transition-colors">
              Contact
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-primary/5 text-foreground mt-16">
      {footerWidgets.length > 0 ? (
        <FooterWidgetRenderer widgets={footerWidgets} />
      ) : (
        <div class="mx-auto max-w-7xl px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
          <!-- Brand -->
          <div>
            <p class="text-lg font-serif font-bold mb-3 text-primary">{kennelName}</p>
            <p class="text-sm text-foreground/70 leading-relaxed">{resolvedDescription}</p>
          </div>

          <!-- Quick Links — top-level CMS pages -->
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-primary/80 mb-4">Quick Links</p>
            <ul class="space-y-2 text-sm">
              {roots.map((p) => (
                <li><a href={`/${p.slug}`} class="text-foreground/70 hover:text-primary transition-colors">{p.title}</a></li>
              ))}
              <li><a href="/dogs" class="text-foreground/70 hover:text-primary transition-colors">Dogs</a></li>
              <li><a href="/litters" class="text-foreground/70 hover:text-primary transition-colors">Litters</a></li>
            </ul>
          </div>

          <!-- Contact -->
          <div>
            <p class="text-sm font-semibold uppercase tracking-wider text-primary/80 mb-4">Contact</p>
            <ul class="space-y-2 text-sm text-foreground/70">
              <li><a href="/contact" class="hover:text-primary transition-colors">Contact Us</a></li>
              <li><a href="/screening" class="hover:text-primary transition-colors">Puppy Application</a></li>
            </ul>
          </div>
        </div>
      )}
      <div class="border-t border-primary/10 py-4 text-center text-xs text-foreground/40">
        &copy; {new Date().getFullYear()} {kennelName}. All rights reserved.
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const hamburger = document.getElementById('hamburger-icon');
      const close = document.getElementById('close-icon');
      btn?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden', isOpen);
        hamburger?.classList.toggle('hidden', !isOpen);
        close?.classList.toggle('hidden', isOpen);
      });
    </script>
  </body>
</html>
