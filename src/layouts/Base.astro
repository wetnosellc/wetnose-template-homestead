---
import '@/styles/global.css';
import MetaTags from '@/components/MetaTags.astro';
import { fetchKennel } from '@/lib/wetnose';

interface Props {
  title: string;
  description?: string;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
}

const {
  title,
  description = "Moro Shepherds — White Swiss Shepherd breeder",
  ogImage,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const fullTitle = title.includes('Moro Shepherds') ? title : `${title} — Moro Shepherds`;
const jsonLdArr = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

let logoUrl: string | null = null;
let kennelName = 'Moro Shepherds';
try {
  const kennel = await fetchKennel();
  logoUrl = kennel.logoUrl;
  kennelName = kennel.name;
} catch (_) {
  // fall back to text logo
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <MetaTags title={fullTitle} description={description} ogImage={ogImage} ogType={ogType} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oooh+Baby&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    {jsonLdArr.map(ld => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-white shadow-sm border-b border-border">
      <div class="mx-auto max-w-7xl px-4">
        <div class="flex items-center justify-between py-2">
          <!-- Logo -->
          <a href="/" class="hover:opacity-90 transition-opacity">
            <img src={logoUrl ?? '/logo.webp'} alt={kennelName} class="h-20 w-auto object-contain" />
          </a>

          <!-- Desktop nav -->
          <nav class="hidden md:flex items-center gap-1">
            <!-- About dropdown -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                About
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 w-52 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150">
                <div class="bg-white border border-border rounded-lg shadow-lg py-1">
                  <a href="/about/bio" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">About Us</a>
                  <a href="/about/puppy-pricing" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Puppy Pricing</a>
                  <a href="/about/contract-info" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Contract Info</a>
                  <a href="/about/kennel-name-change" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Kennel Name Change</a>
                </div>
              </div>
            </div>

            <!-- Dogs dropdown -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                Dogs
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 w-44 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150">
                <div class="bg-white border border-border rounded-lg shadow-lg py-1">
                  <a href="/dogs#males" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Studs</a>
                  <a href="/dogs#females" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Dams</a>
                  <a href="/dogs#for-sale" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">For Sale</a>
                  <a href="/dogs#retired" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Retired</a>
                </div>
              </div>
            </div>

            <!-- Litters dropdown -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                Litters
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 w-44 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150">
                <div class="bg-white border border-border rounded-lg shadow-lg py-1">
                  <a href="/litters#current" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Current</a>
                  <a href="/litters#upcoming" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Upcoming</a>
                  <a href="/litters#planned" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Planned</a>
                  <a href="/litters#past" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Past</a>
                </div>
              </div>
            </div>

            <!-- Breed Info dropdown -->
            <div class="relative group">
              <button class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-foreground hover:text-primary transition-colors rounded-md hover:bg-secondary">
                Breed Info
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 top-full pt-1 w-48 invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-150">
                <div class="bg-white border border-border rounded-lg shadow-lg py-1">
                  <a href="/breed-info/fci-standard" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">FCI Breed Standard</a>
                  <a href="/breed-info/shopping-list" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Shopping List</a>
                  <a href="/breed-info/health-testing" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">Health and Health Testing</a>
                  <a href="/breed-info/history" class="block px-4 py-2 text-sm text-foreground hover:bg-secondary hover:text-primary transition-colors">History of the White Swiss Shepherd</a>
                </div>
              </div>
            </div>

            <a href="/contact" class="ml-2 px-4 py-2 text-sm font-medium bg-primary text-white rounded-md hover:bg-primary/90 transition-colors">
              Contact
            </a>
          </nav>

          <!-- Mobile hamburger -->
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-md text-foreground hover:bg-secondary transition-colors"
            aria-label="Open menu"
          >
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Tagline bar -->
      <div class="bg-accent text-accent-foreground text-center py-2 px-4" style="font-family: 'Oooh Baby', cursive; letter-spacing: 0.13em; font-size: clamp(0.75rem, 2vw, 1.125rem);">
        FCI White Swiss Shepherds of exceptional health, character, and beauty
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white">
        <div class="px-4 py-3 space-y-1">
          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pt-2 pb-1">About</p>
          <a href="/about/bio" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">About Us</a>
          <a href="/about/puppy-pricing" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Puppy Pricing</a>
          <a href="/about/contract-info" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Contract Info</a>
          <a href="/about/kennel-name-change" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Kennel Name Change</a>

          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pt-3 pb-1">Dogs</p>
          <a href="/dogs#males" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Studs</a>
          <a href="/dogs#females" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Dams</a>
          <a href="/dogs#for-sale" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">For Sale</a>
          <a href="/dogs#retired" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Retired</a>

          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pt-3 pb-1">Litters</p>
          <a href="/litters#current" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Current</a>
          <a href="/litters#upcoming" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Upcoming</a>
          <a href="/litters#planned" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Planned</a>
          <a href="/litters#past" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Past</a>

          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider px-2 pt-3 pb-1">Breed Info</p>
          <a href="/breed-info/fci-standard" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">FCI Breed Standard</a>
          <a href="/breed-info/shopping-list" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Shopping List</a>
          <a href="/breed-info/health-testing" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">Health and Health Testing</a>
          <a href="/breed-info/history" class="block px-2 py-2 text-sm text-foreground hover:text-primary transition-colors">History of the White Swiss Shepherd</a>

          <div class="pt-3 pb-2">
            <a href="/contact" class="block w-full text-center px-4 py-2 text-sm font-medium bg-primary text-white rounded-md hover:bg-primary/90 transition-colors">
              Contact
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-accent text-accent-foreground mt-16">
      <div class="mx-auto max-w-7xl px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
        <!-- Brand -->
        <div>
          <p class="text-lg font-bold mb-3">Moro Shepherds</p>
          <p class="text-sm text-accent-foreground/70 leading-relaxed">
            Champion-bred White Swiss Shepherds raised with love in Oregon. FCI-registered, health-tested, family companions.
          </p>
        </div>

        <!-- Quick Links -->
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-accent-foreground/60 mb-4">Quick Links</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/about/bio" class="text-accent-foreground/80 hover:text-white transition-colors">About</a></li>
            <li><a href="/dogs#males" class="text-accent-foreground/80 hover:text-white transition-colors">Males</a></li>
            <li><a href="/dogs#females" class="text-accent-foreground/80 hover:text-white transition-colors">Females</a></li>
            <li><a href="/dogs#for-sale" class="text-accent-foreground/80 hover:text-white transition-colors">Dogs For Sale</a></li>
            <li><a href="/litters#current" class="text-accent-foreground/80 hover:text-white transition-colors">Current Litters</a></li>
            <li><a href="/litters#upcoming" class="text-accent-foreground/80 hover:text-white transition-colors">Upcoming Litters</a></li>
            <li><a href="/litters#planned" class="text-accent-foreground/80 hover:text-white transition-colors">Planned Litters</a></li>
            <li><a href="/breed-info/fci-standard" class="text-accent-foreground/80 hover:text-white transition-colors">Breed Information</a></li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-accent-foreground/60 mb-4">Contact Info</p>
          <ul class="space-y-2 text-sm text-accent-foreground/80">
            <li>
              <a href="/contact" class="hover:text-white transition-colors">Contact Us</a>
            </li>
            <li>Oregon, USA</li>
            <li>
              <a href="/screening" class="hover:text-white transition-colors">Puppy Application</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-accent-foreground/20 py-4 text-center text-xs text-accent-foreground/50">
        &copy; {new Date().getFullYear()} Moro Shepherds. All rights reserved.
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const hamburger = document.getElementById('hamburger-icon');
      const close = document.getElementById('close-icon');
      btn?.addEventListener('click', () => {
        const isOpen = !menu?.classList.contains('hidden');
        menu?.classList.toggle('hidden', isOpen);
        hamburger?.classList.toggle('hidden', !isOpen);
        close?.classList.toggle('hidden', isOpen);
      });
    </script>
  </body>
</html>
