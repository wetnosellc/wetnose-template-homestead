---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fetchKennel } from '@/lib/wetnose';

export async function getStaticPaths() {
  const entries = await getCollection('about');
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const kennel = entry.data.showHero ? await fetchKennel().catch(() => null) : null;
const heroImage = kennel?.coverPhotoUrl ?? null;
---

<Base title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Home
    </a>

    {heroImage && (
      <div class="w-full aspect-video rounded-xl overflow-hidden mb-8">
        <img src={heroImage} alt="Moro Shepherds" class="w-full h-full object-cover" />
      </div>
    )}

    <h1 class="text-4xl font-bold text-foreground mb-2">{entry.data.title}</h1>
    {entry.data.description && (
      <p class="text-lg text-muted-foreground mb-8">{entry.data.description}</p>
    )}

    <div class="prose prose-stone max-w-none text-foreground">
      <Content />
    </div>

    {entry.data.showScreeningCta && (
      <div class="mt-12 bg-white border border-border rounded-xl p-8 text-center">
        <h2 class="text-2xl font-bold text-foreground mb-3">Ready to Apply?</h2>
        <p class="text-muted-foreground mb-6 max-w-xl mx-auto">If you understand and agree to all of the above, and wish to apply to reserve a puppy or purchase an adult that we have listed for sale, please fill out the following application. Note that this is not a formal commitment for you to purchase anything; it is merely a screening tool to help us make informed decisions about you and matching each dog/puppy to the specific family.</p>
        <a href="/screening" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-lg transition-colors">
          Begin Screening Questionnaire
        </a>
        <p class="text-sm text-muted-foreground mt-3">Start your puppy application process</p>
      </div>
    )}
  </div>
</Base>
