---
import Base from '@/layouts/Base.astro';
import AboutSectionCard from '@/components/AboutSectionCard.astro';
import { getEntry } from 'astro:content';
import { fetchKennel, fetchDogs } from '@/lib/wetnose';
import { parseSections } from '@/lib/parse-sections';

const entry = await getEntry('about', 'bio');
const sections = parseSections(entry.body);

const kennel = await fetchKennel().catch(() => null);
const dogs = await fetchDogs({ limit: '3', showOnWebsite: 'true' }).catch(() => ({ items: [] }));
const heroImage = kennel?.coverPhotoUrl ?? dogs.items[0]?.thumbnailPhotoUrl ?? null;

const HEART = `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>`;
const USERS = `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`;
const STETHOSCOPE = `<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>`;
const TARGET = `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>`;
const STAR = `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`;
const AWARD = `<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>`;
const SHIELD = `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>`;
const MAP_PIN = `<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>`;
const PHONE = `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 11 19.79 19.79 0 0 1 1.93 2.32 2 2 0 0 1 3.92 0h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>`;
const INFO = `<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>`;

const ICON_MAP: Record<string, string> = {
  'Our Story': HEART,
  'Breed Club Leadership': USERS,
  'Health Testing Excellence': STETHOSCOPE,
  'Our Breeding Philosophy': TARGET,
  'Versatility & Natural Abilities': STAR,
  'Our Background': AWARD,
  'Care & Nutrition': SHIELD,
  'Location': MAP_PIN,
  'Get in Touch': PHONE,
};
---

<Base title={`${entry.data.title} — Moro Shepherds`} description={entry.data.description}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Home
    </a>
    <div class="bg-white rounded-xl border border-gray-200/50 shadow-lg overflow-hidden">
      <div class="p-8">
        <div class="text-center mb-10">
          <h1 class="text-4xl font-bold text-gray-700 mb-2">{entry.data.title}</h1>
          {entry.data.description && <p class="text-lg text-gray-500 max-w-2xl mx-auto">{entry.data.description}</p>}
        </div>
        {heroImage && (
          <div class="bg-blue-100 rounded-xl border border-blue-200 shadow-md overflow-hidden mb-6">
            <div class="p-6">
              <div class="relative aspect-[16/9] overflow-hidden rounded-lg shadow-lg">
                <img src={heroImage} alt="Moro Shepherds" class="w-full h-full object-cover" />
              </div>
            </div>
          </div>
        )}
        <div class="space-y-4">
          {sections.map(({ heading, html }) => (
            <AboutSectionCard title={heading} iconInner={ICON_MAP[heading] ?? INFO}>
              <div set:html={html} class="space-y-2" />
            </AboutSectionCard>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>
