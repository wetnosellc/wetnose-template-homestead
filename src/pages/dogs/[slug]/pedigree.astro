---
import Base from '@/layouts/Base.astro';
import PedigreeTree from '@/components/PedigreeTree.astro';
import { fetchDogs, fetchDog, fetchDogPedigree } from '@/lib/wetnose';
import { dogSlug, buildDogSlugMap } from '@/lib/slugs';

export async function getStaticPaths() {
  const result = await fetchDogs({ limit: '100' });
  const dogs = result.items;
  const slugMap = buildDogSlugMap(dogs);
  return Array.from(slugMap.entries()).map(([slug, dogId]) => ({
    params: { slug },
    props: { dogId },
  }));
}

interface Props {
  dogId: string;
}
const { dogId } = Astro.props;

const [dog, pedigree] = await Promise.all([
  fetchDog(dogId),
  fetchDogPedigree(dogId, 4).catch(() => null),
]);

const currentSlug = dogSlug(dog);
---

<Base title={`Pedigree — ${dog.callName ?? dog.registeredName}`}>
  <div class="mx-auto max-w-7xl px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="text-sm text-muted-foreground mb-6">
      <a href="/dogs" class="hover:text-primary transition-colors">Dogs</a>
      <span class="mx-2">/</span>
      <a href={`/dogs/${currentSlug}`} class="hover:text-primary transition-colors">{dog.callName ?? dog.registeredName}</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">Pedigree</span>
    </nav>

    <h1 class="text-3xl font-bold text-foreground mb-2">
      Pedigree — {dog.callName ?? dog.registeredName}
    </h1>
    <p class="text-muted-foreground mb-8">4-generation pedigree</p>

    {pedigree ? (
      <div class="overflow-x-auto">
        <div class="min-w-[700px]">
          <PedigreeTree node={pedigree} generation={0} maxGenerations={4} />
        </div>
      </div>
    ) : (
      <div class="bg-secondary rounded-xl p-10 text-center text-muted-foreground">
        Pedigree information is not available for this dog.
      </div>
    )}

    <div class="mt-8">
      <a href={`/dogs/${currentSlug}`} class="text-sm text-primary hover:underline">
        ← Back to {dog.callName ?? dog.registeredName}
      </a>
    </div>
  </div>
</Base>
