---
import Base from '@/layouts/Base.astro';
import HeroCarousel from '@/components/HeroCarousel.tsx';
import { fetchKennel, fetchDogs, fetchLitters } from '@/lib/wetnose';
import { getLitterStatus } from '@/lib/litter-status';
import { litterSlug, buildLitterSlugMap } from '@/lib/slugs';

const kennel = await fetchKennel();
const [dogsResult, littersResult] = await Promise.all([
  fetchDogs({ limit: '8', showOnWebsite: 'true' }),
  fetchLitters({ limit: '100' }),
]);

// Placeholder shepherd photos from the Figma design (Unsplash, used when API has no photos)
const PLACEHOLDER_HERO_SLIDES = [
  {
    image: "https://images.unsplash.com/photo-1551717743-49959800b1f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80",
    alt: "White Swiss Shepherd",
  },
  {
    image: "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80",
    alt: "White Swiss Shepherd family",
  },
  {
    image: "https://images.unsplash.com/photo-1518717758536-85ae29035b6d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80",
    alt: "White Swiss Shepherd portrait",
  },
];

const PLACEHOLDER_STORY_IMAGE = "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80";

// Build hero slides from API dog thumbnails, fill gaps with placeholder slides
const apiSlides = dogsResult.items
  .filter(d => d.thumbnailPhotoUrl)
  .slice(0, 6)
  .map(d => ({
    image: d.thumbnailPhotoUrl!,
    alt: d.callName ?? d.registeredName,
  }));

// If the API returned no thumbnails, try using embedded photos for the first dog
if (apiSlides.length === 0 && dogsResult.items.length > 0) {
  const firstDog = dogsResult.items[0];
  for (const p of (firstDog.photos ?? []).slice(0, 4)) {
    apiSlides.push({ image: p.url, alt: firstDog.callName ?? firstDog.registeredName });
  }
}

// Use API slides when available, otherwise fall back to placeholder slides
const heroSlides = apiSlides.length > 0 ? apiSlides : PLACEHOLDER_HERO_SLIDES;

// Determine available litters
const allLitters = littersResult.items;
const hasPuppiesAvailable = allLitters.some(l => getLitterStatus(l) === 'Current');

const currentUpcomingLitters = allLitters.filter(l => {
  const s = getLitterStatus(l);
  return s === 'Current' || s === 'Upcoming';
}).slice(0, 6);

const slugMap = buildLitterSlugMap(allLitters);
const inverseSlugMap = new Map<string, string>();
for (const [s, id] of slugMap) {
  inverseSlugMap.set(id, s);
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function statusBadgeClass(status: string): string {
  if (status === 'Current') return 'bg-green-100 text-green-800 border border-green-400';
  if (status === 'Upcoming') return 'bg-yellow-100 text-yellow-800 border border-yellow-400';
  return 'bg-gray-100 text-gray-800 border border-gray-300';
}

const enrichedLitters = currentUpcomingLitters.map(litter => ({
  litter,
  status: getLitterStatus(litter),
  slug: inverseSlugMap.get(litter.id) ?? litterSlug(litter),
}));

// "Our Story" image — prefer a real dog photo, fall back to placeholder
const storyImageUrl = dogsResult.items.find(d => d.thumbnailPhotoUrl)?.thumbnailPhotoUrl ?? PLACEHOLDER_STORY_IMAGE;

const homeDescription = kennel.description
  ?? "Moro Shepherds — champion-bred White Swiss Shepherds with comprehensive health testing, raised with love in Oregon.";

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": kennel.name,
  "url": "https://moroshepherds.com",
  "logo": kennel.logoUrl ?? undefined,
  "description": homeDescription,
  "sameAs": kennel.website ? [kennel.website] : [],
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://moroshepherds.com" },
  ],
};

const testimonials = [
  {
    image: "https://images.unsplash.com/photo-1544717297-fa95b6ee9643?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80",
    alt: "Happy family with their White Swiss Shepherd",
    text: "Luna has been the most incredible addition to our family. Her temperament is perfect with our children, and her intelligence never ceases to amaze us. She's currently training to be a therapy dog.",
    author: "Sarah",
    location: "Portland, OR",
  },
  {
    image: "https://images.unsplash.com/photo-1551717743-49959800b1f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80",
    alt: "Professional service dog trainer",
    text: "As a service dog trainer, I can honestly say that the dogs from Moro Shepherds are exceptional. Their breeding program produces dogs with the perfect combination of intelligence, stability, and work drive.",
    author: "Michael",
    location: "Service Dog Trainer",
  },
  {
    image: "https://images.unsplash.com/photo-1583337130417-3346a1be7dee?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80",
    alt: "White Swiss Shepherd with family",
    text: "Zeus is everything we hoped for and more. His health clearances gave us confidence, and his personality has brought so much joy to our home. The support from Moro Shepherds has been outstanding.",
    author: "The Martinez Family",
    location: "Sacramento, CA",
  },
  {
    image: "https://images.unsplash.com/photo-1518717758536-85ae29035b6d?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80",
    alt: "Search and Rescue team with shepherd",
    text: "Our Search & Rescue team has worked with several dogs from Moro Shepherds. Their work ethic, intelligence, and trainability make them excellent SAR dogs. We couldn't be happier.",
    author: "Captain Lisa",
    location: "Oregon SAR Team",
  },
  {
    image: "https://images.unsplash.com/photo-1587300003388-59208cc962cb?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80",
    alt: "Couple with their gentle shepherd",
    text: "Bella has exceeded all our expectations. She's gentle with our elderly mother, alert as a companion, and her beauty turns heads everywhere we go. The health guarantees gave us peace of mind.",
    author: "Robert & Janet",
    location: "Seattle, WA",
  },
  {
    image: "https://images.unsplash.com/photo-1552053831-71594a27632d?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80",
    alt: "Young woman with her shepherd puppy",
    text: "The professionalism and knowledge at Moro Shepherds is unmatched. They matched us with the perfect puppy for our lifestyle, and their ongoing support has been invaluable. Max is thriving!",
    author: "Jennifer",
    location: "San Francisco, CA",
  },
];
---

<Base
  title={kennel.name}
  description={homeDescription}
  ogImage={heroSlides[0]?.image ?? kennel.logoUrl}
  jsonLd={[orgJsonLd, breadcrumbJsonLd]}
>
  <!-- Hero Carousel -->
  <HeroCarousel
    client:load
    slides={heroSlides}
    title={kennel.name}
    subtitle={kennel.description ?? "Champion-bred White Swiss Shepherds raised with love."}
    hasPuppiesAvailable={hasPuppiesAvailable}
  />

  <!-- Why Choose Us -->
  <section class="py-16 px-4 bg-white">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-3xl font-bold text-center text-foreground mb-3">Why Choose Moro Shepherds</h2>
      <p class="text-center text-muted-foreground mb-12 max-w-2xl mx-auto">
        We are dedicated to producing healthy, well-tempered White Swiss Shepherds that excel as family companions and working dogs.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6 bg-secondary rounded-xl">
          <div class="w-14 h-14 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-yellow-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-foreground mb-2">Champion Bloodlines</h3>
          <p class="text-sm text-muted-foreground">Our dogs carry internationally recognized champion titles from FCI-affiliated competitions across Europe and North America.</p>
        </div>

        <div class="text-center p-6 bg-secondary rounded-xl">
          <div class="w-14 h-14 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-green-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-foreground mb-2">Health Tested</h3>
          <p class="text-sm text-muted-foreground">All breeding dogs are tested for hips, elbows, eyes, and genetic conditions. Health clearances are transparently available for every dog.</p>
        </div>

        <div class="text-center p-6 bg-secondary rounded-xl">
          <div class="w-14 h-14 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-foreground mb-2">Service Dog Quality</h3>
          <p class="text-sm text-muted-foreground">Our puppies are raised using Early Neurological Stimulation and early socialization protocols to ensure exceptional temperament.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Available Litters -->
  {currentUpcomingLitters.length > 0 && (
    <section class="py-16 px-4 bg-background">
      <div class="mx-auto max-w-7xl">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h2 class="text-3xl font-bold text-foreground mb-1">Available Litters</h2>
            <p class="text-muted-foreground">Puppies currently available or coming soon</p>
          </div>
          <a href="/litters" class="hidden md:inline-block text-sm font-medium text-primary hover:underline">
            View all litters →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {enrichedLitters.map(({ litter, status, slug }) => (
            <a href={`/litters/${slug}`} class="block bg-white rounded-xl shadow hover:shadow-md transition-shadow overflow-hidden border border-border group">
              {litter.photos?.[0]?.url ? (
                <img src={litter.photos[0].url} alt={litter.litterName} class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300" />
              ) : (
                <div class="w-full h-44 bg-stone-200 flex items-center justify-center text-muted-foreground text-sm">No photo</div>
              )}
              <div class="p-4">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <h3 class="font-semibold text-foreground">{litter.litterName}</h3>
                  <span class={`text-xs px-2 py-0.5 rounded-full font-medium whitespace-nowrap ${statusBadgeClass(status)}`}>{status}</span>
                </div>
                {(litter.sire || litter.dam) && (
                  <p class="text-sm text-muted-foreground mb-1">
                    {litter.sire?.callName ?? litter.sire?.registeredName ?? '?'} × {litter.dam?.callName ?? litter.dam?.registeredName ?? '?'}
                  </p>
                )}
                {litter.birthDate && (
                  <p class="text-xs text-muted-foreground">{formatDate(litter.birthDate)}</p>
                )}
              </div>
            </a>
          ))}
        </div>
        <div class="mt-6 text-center md:hidden">
          <a href="/litters" class="text-sm font-medium text-primary hover:underline">View all litters →</a>
        </div>
      </div>
    </section>
  )}

  <!-- Our Story -->
  <section class="py-16 px-4 bg-white">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-foreground mb-4">Our Story</h2>
          <p class="text-muted-foreground mb-4">
            Located on 5 acres just outside of Albany, Oregon, Moro Shepherds is dedicated to producing some of the finest White Swiss Shepherds in the world. Our dogs are family pets as well as breeding stock, traveling and showing in FCI and UKC conformation events.
          </p>
          <p class="text-muted-foreground mb-6">
            We are founders of the White Swiss Shepherd Club of America, where we tabulate health data and act as custodians for the breed. Every puppy is born in our home, socialized with children and other animals, and placed only with families committed to giving them a loving forever home.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/about/bio" class="inline-block text-center bg-primary text-white font-medium px-5 py-2.5 rounded-lg hover:bg-primary/90 transition-colors">
              Learn More About Us
            </a>
            <a href="/contact" class="inline-block text-center border border-border text-foreground font-medium px-5 py-2.5 rounded-lg hover:bg-secondary transition-colors">
              Get in Touch
            </a>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden shadow-md">
          <img
            src={storyImageUrl}
            alt="Our dogs"
            class="w-full h-80 object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 px-4 bg-background">
    <div class="mx-auto max-w-7xl">
      <h2 class="text-3xl font-bold text-center text-foreground mb-3">What Our Families Say</h2>
      <p class="text-center text-muted-foreground mb-12 max-w-2xl mx-auto">
        Hear from the families who have welcomed our White Swiss Shepherds into their homes and hearts.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden border border-border flex flex-col">
            <img
              src={t.image}
              alt={t.alt}
              class="w-full h-48 object-cover"
            />
            <div class="p-5 flex flex-col flex-1">
              <blockquote class="text-sm text-muted-foreground leading-relaxed flex-1 italic">
                "{t.text}"
              </blockquote>
              <div class="mt-4 pt-4 border-t border-border">
                <p class="text-sm font-semibold text-foreground">— {t.author}</p>
                <p class="text-xs text-muted-foreground">{t.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-14 px-4 bg-primary text-white">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold mb-3">Ready to Add a Moro Shepherd to Your Family?</h2>
      <p class="text-white/80 mb-8">Fill out our puppy application to get started. We carefully match each puppy to the right home.</p>
      <a href="/screening" class="inline-block bg-white text-primary font-semibold px-8 py-3 rounded-lg hover:bg-stone-100 transition-colors shadow">
        Apply for a Puppy
      </a>
    </div>
  </section>
</Base>
