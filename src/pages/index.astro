---
import Base from '@/layouts/Base.astro';
import WidgetRenderer from '@/components/WidgetRenderer.astro';
import { safeGetManifest, safeGetSitePage } from '@/lib/client';

const manifest = await safeGetManifest();
const kennelName = manifest?.kennelName ?? 'Kennel';
const kennelDescription = manifest?.siteDescription ?? '';
const logoUrl = manifest?.logoUrl ?? null;
const coverPhotoUrl = manifest?.coverPhotoUrl ?? null;

let widgets: import('@wetnosellc/template-kit').Widget[] = [];
let pageTitle = kennelName;
let pageDescription = kennelDescription || `${kennelName} — kennel website`;
if (manifest) {
  const homeStub = manifest.pages.find((p) => p.slug === '' || p.slug === 'home' || p.slug === '/');
  if (homeStub) {
    const page = await safeGetSitePage(homeStub.slug);
    if (page) {
      widgets = page.widgets ?? [];
      if (page.title) pageTitle = page.title;
    }
  }
}
---

<Base
  title={pageTitle}
  description={pageDescription}
  ogImage={coverPhotoUrl ?? logoUrl}
>
  {widgets.length > 0 ? (
    <WidgetRenderer widgets={widgets} />
  ) : (
    <div class="py-32 px-6 bg-background">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="text-5xl font-serif font-bold text-foreground mb-4">{kennelName}</h1>
        {kennelDescription && (
          <p class="text-lg text-foreground/70 leading-relaxed mb-8">{kennelDescription}</p>
        )}
        <div class="flex justify-center gap-4 flex-wrap">
          <a href="/dogs" class="px-6 py-3 bg-primary text-white font-medium rounded-lg hover:bg-primary/90 transition-colors">
            Meet Our Dogs
          </a>
          <a href="/litters" class="px-6 py-3 border border-foreground/20 text-foreground font-medium rounded-lg hover:bg-foreground/5 transition-colors">
            View Litters
          </a>
        </div>
      </div>
    </div>
  )}
</Base>
