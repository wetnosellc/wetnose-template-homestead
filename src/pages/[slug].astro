---
import Base from '../layouts/Base.astro';
import WidgetRenderer from '../components/WidgetRenderer.astro';
import { safeGetManifest, safeGetSitePage } from '@/lib/client';

export async function getStaticPaths() {
  const manifest = await safeGetManifest();
  if (!manifest) return [];
  const reserved = new Set(['dogs', 'litters', 'contact', 'screening', '404', '', '/']);
  const eligible = manifest.pages.filter(
    (p) => p.slug && !reserved.has(p.slug) && p.pageKind !== 'special',
  );
  const entries = await Promise.all(
    eligible.map(async (stub) => {
      const page = await safeGetSitePage(stub.slug);
      if (!page) return null;
      return { params: { slug: stub.slug }, props: { page } };
    }),
  );
  return entries.filter((e): e is NonNullable<typeof e> => e !== null);
}

const { page } = Astro.props;
---

<Base title={page.title}>
  <div class="bg-white">
    <div class="max-w-5xl mx-auto px-4 py-6 md:py-8">
      <h1 class="text-4xl font-bold text-gray-900">{page.title}</h1>
    </div>
  </div>
  <WidgetRenderer widgets={page.widgets ?? []} />
</Base>
