---
import Base from '../layouts/Base.astro';
import WidgetRenderer from '../components/WidgetRenderer.astro';
import { fetchManifest, fetchSitePage } from '@/lib/wetnose';

export async function getStaticPaths() {
  const manifest = await fetchManifest();
  // Skip reserved template routes so a CMS page named "dogs" can't clobber the
  // built-in dogs index. These slugs are owned by the template.
  const reserved = new Set([
    'dogs',
    'litters',
    'contact',
    'screening',
    '404',
    '',
  ]);

  const eligible = manifest.pages.filter(
    (p) => !reserved.has(p.slug) && p.pageKind !== 'special',
  );

  const entries = await Promise.all(
    eligible.map(async (stub) => {
      try {
        const page = await fetchSitePage(stub.slug);
        return { params: { slug: stub.slug }, props: { page } };
      } catch (err) {
        console.warn(`[cms] failed to fetch page "${stub.slug}":`, err);
        return null;
      }
    }),
  );

  return entries.filter((e): e is NonNullable<typeof e> => e !== null);
}

const { page } = Astro.props;
---

<Base title={page.title}>
  <div class="bg-white">
    <div class="max-w-5xl mx-auto px-4 py-6 md:py-8">
      <h1 class="text-4xl font-bold text-gray-900">{page.title}</h1>
    </div>
  </div>
  <WidgetRenderer widgets={page.widgets ?? []} />
</Base>
