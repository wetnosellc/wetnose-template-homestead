---
import Base from '@/layouts/Base.astro';
import AboutSectionCard from '@/components/AboutSectionCard.astro';
import { getEntry } from 'astro:content';
import { parseSections } from '@/lib/parse-sections';

const entry = await getEntry('breed-info', 'health-testing');
const sections = parseSections(entry.body);

const BONE = `<path d="M17 10c.7-.7 1.69 0 2.5 0a2.5 2.5 0 1 0 0-5 .5.5 0 0 1-.5-.5 2.5 2.5 0 1 0-5 0c0 .81.7 1.8 0 2.5l-7 7c-.7.7-1.69 0-2.5 0a2.5 2.5 0 0 0 0 5c.28 0 .5.22.5.5a2.5 2.5 0 1 0 5 0c0-.81-.7-1.8 0-2.5Z"/>`;
const ACTIVITY = `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>`;
const FLASK = `<path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/>`;
const DNA = `<path d="M2 15c6.667-6 13.333 0 20-6"/><path d="M9 22c1.798-1.998 2.518-3.995 2.807-5.993"/><path d="M15 2c-1.798 1.998-2.518 3.995-2.807 5.993"/><path d="m17 6-2.5-2.5"/><path d="m14 8-1-1"/><path d="m7 18 2.5 2.5"/><path d="m3.5 14.5.5.5"/><path d="m6 12 .5.5"/><path d="m10 10 .5.5"/>`;
const HEART = `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>`;
const SHIELD = `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>`;
const PLUS = `<circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/>`;
const STETHOSCOPE = `<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>`;
const INFO = `<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>`;

const ICON_MAP: Record<string, string> = {
  'Hips': BONE,
  'Elbows': ACTIVITY,
  'MDR1': FLASK,
  'DM — Degenerative Myelopathy': DNA,
  'vWD — Von Willebrand\'s Disease': HEART,
  'Hemophilia A': SHIELD,
  'Additional Testing': PLUS,
  'How to Have Tests Done': STETHOSCOPE,
};

// Intro text is the content before the first ## heading
const introText = entry.body.split(/\n(?=## )/)[0].trim();
---

<Base title={`${entry.data.title} — Moro Shepherds`} description={entry.data.description}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Home
    </a>
    <div class="bg-white rounded-xl border border-gray-200/50 shadow-lg overflow-hidden">
      <div class="p-8">
        <div class="text-center mb-10">
          <h1 class="text-4xl font-bold text-gray-700 mb-2">{entry.data.title}</h1>
          {entry.data.description && <p class="text-lg text-gray-500 max-w-2xl mx-auto">{entry.data.description}</p>}
        </div>
        {introText && (
          <div class="bg-blue-100 rounded-xl border border-blue-200 shadow-md p-5 mb-6 text-sm text-gray-600">{introText}</div>
        )}
        <div class="space-y-4">
          {sections.map(({ heading, html }) => (
            <AboutSectionCard title={heading} iconInner={ICON_MAP[heading] ?? INFO}>
              <div set:html={html} class="space-y-2" />
            </AboutSectionCard>
          ))}
        </div>
      </div>
    </div>
  </div>
</Base>
