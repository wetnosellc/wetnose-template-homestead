---
import Base from '@/layouts/Base.astro';
import PhotoGallery from '@/components/PhotoGallery.tsx';
import { fetchLitters, fetchLitter } from '@/lib/wetnose';
import { getLitterStatus } from '@/lib/litter-status';
import { dogSlug, buildLitterSlugMap } from '@/lib/slugs';

export async function getStaticPaths() {
  const result = await fetchLitters({ limit: '100' });
  const litters = result.items.filter(l => l.litterName !== null);
  const slugMap = buildLitterSlugMap(litters);
  return Array.from(slugMap.entries()).map(([slug, litterId]) => ({
    params: { slug },
    props: { litterId },
  }));
}

interface Props {
  litterId: string;
}
const { litterId } = Astro.props;

const litter = await fetchLitter(litterId);
const status = getLitterStatus(litter);

const galleryPhotos = (litter.photos ?? []).map(p => ({ url: p.url, caption: p.caption }));

const statusBadge: Record<string, string> = {
  Current: 'bg-green-100 text-green-800 border border-green-400',
  Upcoming: 'bg-yellow-100 text-yellow-800 border border-yellow-400',
  Planned: 'bg-blue-100 text-blue-800 border border-blue-400',
  'Sold Out': 'bg-gray-200 text-gray-700 border border-gray-300',
  Past: 'bg-gray-200 text-gray-700 border border-gray-300',
  Unknown: 'bg-gray-100 text-gray-600 border border-gray-200',
};
const badgeClass = statusBadge[status] ?? statusBadge['Unknown'];

function formatDate(d: string | null): string {
  if (!d) return '';
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const salesStatusBadge: Record<string, string> = {
  available: 'bg-green-100 text-green-800 border border-green-400',
  reserved: 'bg-yellow-100 text-yellow-800 border border-yellow-400',
  sold: 'bg-gray-200 text-gray-700 border border-gray-300',
  guardian: 'bg-blue-100 text-blue-800 border border-blue-400',
};

const sireSlug = litter.sire ? dogSlug(litter.sire) : null;
const damSlug = litter.dam ? dogSlug(litter.dam) : null;

const currentLitterSlug = Astro.params.slug;
const ogImage = galleryPhotos[0]?.url ?? null;
const sireName = litter.sire?.callName ?? litter.sire?.registeredName ?? null;
const damName = litter.dam?.callName ?? litter.dam?.registeredName ?? null;
const parentStr = sireName && damName ? `${sireName} × ${damName}` : sireName ?? damName ?? null;
const litterDisplayName = litter.litterName ?? (parentStr ?? 'Litter');
const metaTitle = parentStr
  ? `${litterDisplayName} litter — ${parentStr} — Moro Shepherds`
  : `${litterDisplayName} litter — Moro Shepherds`;
const metaDesc = litter.notes
  ? litter.notes.slice(0, 160).trimEnd() + (litter.notes.length > 160 ? '…' : '')
  : parentStr
    ? `${litterDisplayName} litter by ${parentStr}. ${status} — White Swiss Shepherd puppies at Moro Shepherds.`
    : `${litterDisplayName} — White Swiss Shepherd litter at Moro Shepherds.`;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://moroshepherds.com" },
    { "@type": "ListItem", "position": 2, "name": "Litters", "item": "https://moroshepherds.com/litters" },
    { "@type": "ListItem", "position": 3, "name": litterDisplayName, "item": `https://moroshepherds.com/litters/${currentLitterSlug}` },
  ],
};
---

<Base title={metaTitle} description={metaDesc} ogImage={ogImage} jsonLd={breadcrumbJsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="text-sm text-muted-foreground mb-6">
      <a href="/litters" class="hover:text-primary transition-colors">Litters</a>
      <span class="mx-2">/</span>
      <span class="text-foreground">{litterDisplayName}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      <!-- Left: Photos -->
      <div>
        {galleryPhotos.length > 0 ? (
          <PhotoGallery
            client:visible
            photos={galleryPhotos}
            altPrefix={litterDisplayName}
          />
        ) : (
          <div class="w-full aspect-video bg-stone-200 rounded-lg flex items-center justify-center text-muted-foreground">
            No photos available
          </div>
        )}
      </div>

      <!-- Right: Details -->
      <div class="space-y-6">
        <div>
          <div class="flex items-start gap-3 mb-2">
            <h1 class="text-3xl font-bold text-foreground">{litterDisplayName}</h1>
            <span class={`mt-1 text-sm px-3 py-1 rounded-full font-medium flex-shrink-0 ${badgeClass}`}>{status}</span>
          </div>
          {(litter.sire || litter.dam) && (
            <p class="text-muted-foreground mb-1">
              {sireSlug ? (
                <a href={`/dogs/${sireSlug}`} class="hover:text-primary transition-colors">
                  {litter.sire?.callName ?? litter.sire?.registeredName ?? '?'}
                </a>
              ) : (litter.sire?.callName ?? litter.sire?.registeredName ?? '?')}
              {' × '}
              {damSlug ? (
                <a href={`/dogs/${damSlug}`} class="hover:text-primary transition-colors">
                  {litter.dam?.callName ?? litter.dam?.registeredName ?? '?'}
                </a>
              ) : (litter.dam?.callName ?? litter.dam?.registeredName ?? '?')}
            </p>
          )}
        </div>

        {litter.expectedTraits && litter.expectedTraits.length > 0 && (
          <div>
            <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wide mb-2">Expected Traits</h2>
            <div class="flex flex-wrap gap-2">
              {litter.expectedTraits.map(trait => (
                <span class="text-xs px-2.5 py-1 bg-secondary rounded-full text-muted-foreground border border-border">{trait}</span>
              ))}
            </div>
          </div>
        )}

        <!-- Parent links -->
        {(sireSlug || damSlug) && (
          <div class="flex gap-3">
            {sireSlug && litter.sire && (
              <a href={`/dogs/${sireSlug}`} class="text-sm border border-border px-4 py-2 rounded-lg hover:bg-secondary transition-colors">
                View {litter.sire.callName ?? litter.sire.registeredName}
              </a>
            )}
            {damSlug && litter.dam && (
              <a href={`/dogs/${damSlug}`} class="text-sm border border-border px-4 py-2 rounded-lg hover:bg-secondary transition-colors">
                View {litter.dam.callName ?? litter.dam.registeredName}
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    <!-- Puppies table -->
    {litter.puppies && litter.puppies.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-semibold text-foreground mb-4">Puppies ({litter.puppies.length})</h2>
        <div class="overflow-x-auto rounded-xl border border-border">
          <table class="w-full text-sm">
            <thead class="bg-secondary">
              <tr>
                <th class="text-left px-4 py-3 font-medium text-muted-foreground">Sex</th>
                <th class="text-left px-4 py-3 font-medium text-muted-foreground">Name</th>
                <th class="text-left px-4 py-3 font-medium text-muted-foreground">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {litter.puppies.map(puppy => (
                <tr class="bg-white hover:bg-secondary/50 transition-colors">
                  <td class="px-4 py-3">
                    <span class={`text-xs px-2 py-0.5 rounded-full font-medium ${puppy.sex === 'M' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800'}`}>
                      {puppy.sex === 'M' ? 'Male' : 'Female'}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-foreground font-medium">{puppy.callName ?? '—'}</td>
                  <td class="px-4 py-3">
                    {puppy.salesStatus ? (
                      <span class={`text-xs px-2 py-0.5 rounded-full font-medium capitalize ${salesStatusBadge[puppy.salesStatus] ?? 'bg-gray-100 text-gray-700'}`}>
                        {puppy.salesStatus}
                      </span>
                    ) : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Notes -->
    {litter.notes && (
      <div class="mt-8 bg-white border border-border rounded-xl p-6">
        <h2 class="text-lg font-semibold text-foreground mb-3">Notes</h2>
        <p class="text-muted-foreground whitespace-pre-line">{litter.notes}</p>
      </div>
    )}
  </div>
</Base>
