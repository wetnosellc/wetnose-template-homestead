---
import { fetchDogs } from "../../lib/wetnose";
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { filter = "all", limit = 12, layout = "grid" } = widget.props as {
  filter?: "sires" | "dams" | "all";
  limit?: number;
  layout?: "grid" | "list";
};

// Map widget filter to API params
const statusFilter = {
  sires: "Sire",
  dams: "Dam",
  all: undefined,
}[filter];

const params: Record<string, string> = {
  limit: String(limit),
  showOnWebsite: "true",
};

if (statusFilter) {
  params.status = statusFilter;
}

const response = await fetchDogs(params);
const dogs = response.items || [];
---

{
  dogs.length === 0 ? (
    <section class="py-12 px-4 md:px-8">
      <div class="text-center text-muted-foreground">No dogs to display.</div>
    </section>
  ) : layout === "list" ? (
    <section class="py-16 px-4 md:px-8">
      <div class="max-w-4xl mx-auto space-y-8">
        {dogs.map((dog) => (
          <div class="flex gap-8 pb-8 border-b border-border/50 last:border-b-0">
            {dog.thumbnailPhotoUrl && (
              <div class="flex-shrink-0 w-32 h-40 rounded-2xl overflow-hidden">
                <img
                  src={dog.thumbnailPhotoUrl}
                  alt={dog.callName || dog.registeredName}
                  class="w-full h-full object-cover"
                />
              </div>
            )}
            <div class="flex-1">
              <h3 class="text-2xl font-serif font-bold text-primary mb-1">
                {dog.callName || dog.registeredName}
              </h3>
              {dog.status && (
                <p class="text-sm font-medium text-accent mb-3">{dog.status}</p>
              )}
              {dog.description && (
                <p class="text-base text-foreground/70 leading-relaxed">{dog.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  ) : (
    <section class="py-16 px-4 md:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {dogs.map((dog) => (
          <div class="flex flex-col overflow-hidden">
            {dog.thumbnailPhotoUrl && (
              <div class="aspect-[3/4] overflow-hidden rounded-2xl mb-4">
                <img
                  src={dog.thumbnailPhotoUrl}
                  alt={dog.callName || dog.registeredName}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                />
              </div>
            )}
            <h3 class="text-lg font-serif font-bold text-primary mb-1">
              {dog.callName || dog.registeredName}
            </h3>
            {dog.status && (
              <p class="text-sm text-accent font-medium mb-2">{dog.status}</p>
            )}
            {dog.description && (
              <p class="text-sm text-foreground/60 line-clamp-2">{dog.description}</p>
            )}
          </div>
        ))}
      </div>
    </section>
  )
}
