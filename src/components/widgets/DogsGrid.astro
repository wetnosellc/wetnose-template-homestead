---
import { getClient } from "@/lib/client";
import type { WidgetInstance } from "@/lib/template-kit";
import type { Dog } from "@wetnosellc/template-kit";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { filter = "all", status, limit = 12, layout = "grid" } = widget.props as {
  filter?: "sires" | "dams" | "all";
  status?: "active" | "for-sale" | "retired" | "all";
  limit?: number;
  layout?: "grid" | "list";
};

let dogs: Dog[] = [];
const client = getClient();
if (client) {
  try {
    dogs = await client.getDogsForGrid({
      filter: filter === "sires" || filter === "dams" ? filter : "all",
      status: status ?? "active",
      limit: typeof limit === "number" && limit > 0 ? limit : 12,
    });
  } catch (_) { dogs = []; }
}
---

{
  dogs.length === 0 ? (
    <section class="py-12 px-6">
      <div class="text-center text-foreground/60">No dogs to display.</div>
    </section>
  ) : (
    <section class="py-20 px-6">
      <div class="max-w-6xl mx-auto space-y-24">
        {dogs.map((dog, idx) => {
          const isEven = idx % 2 === 0;
          return (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
              {/* Image column */}
              <div class={`${isEven ? "md:col-span-5 md:col-start-1" : "md:col-span-5 md:col-start-8 md:order-2"}`}>
                {dog.thumbnailPhotoUrl && (
                  <img
                    src={dog.thumbnailPhotoUrl}
                    alt={dog.name}
                    class="w-full aspect-[4/5] rounded-2xl object-cover"
                  />
                )}
              </div>

              {/* Text column */}
              <div class={`${isEven ? "md:col-span-6 md:col-start-7" : "md:col-span-6 md:col-start-1 md:order-1"}`}>
                <div class="text-xs uppercase tracking-widest text-accent mb-3">
                  {dog.statuses[0]?.name || "Our Dog"}
                </div>
                <h3 class="text-4xl md:text-5xl font-serif font-bold text-primary mb-2">
                  {dog.name}
                </h3>
                <p class="text-sm uppercase tracking-wider text-foreground/60 mb-6">
                  {dog.callName && dog.registeredName !== dog.callName ? dog.registeredName : ""}
                </p>
                {dog.description && (
                  <p class="text-lg leading-relaxed text-foreground/80">
                    {dog.description}
                  </p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )
}
