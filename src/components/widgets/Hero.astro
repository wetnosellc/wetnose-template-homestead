---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  image,
  headline,
  subheadline,
  ctaText,
  ctaUrl,
} = widget.props as {
  image?: string;
  headline: string;
  subheadline?: string;
  ctaText?: string;
  ctaUrl?: string;
};
---

<section class="py-24 md:py-32 px-6 bg-background">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-3xl">
      {/* Kicker */}
      <div class="text-xs uppercase tracking-widest text-primary mb-6">
        From our kennel
      </div>

      {/* Headline */}
      <h1 class="text-6xl md:text-8xl font-serif font-bold leading-[1.05] text-foreground mb-8">
        {headline}
      </h1>

      {/* Subheadline */}
      {subheadline && (
        <p class="text-xl md:text-2xl text-foreground/70 leading-relaxed mb-10 max-w-2xl">
          {subheadline}
        </p>
      )}

      {/* CTA */}
      {ctaText && ctaUrl && (
        <a
          href={ctaUrl}
          class="inline-block bg-accent text-white px-8 py-3 rounded-full hover:bg-accent/90 transition font-medium"
        >
          {ctaText}
        </a>
      )}
    </div>

    {/* Photo plate below headline */}
    {image && (
      <div class="max-w-4xl mx-auto mt-16">
        <img
          src={image}
          alt={headline}
          class="w-full aspect-[16/10] rounded-2xl object-cover"
        />
      </div>
    )}
  </div>
</section>
