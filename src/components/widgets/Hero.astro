---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  image,
  headline,
  subheadline,
  ctaText,
  ctaUrl,
  layout = "full-bleed",
} = widget.props as {
  image?: string;
  headline: string;
  subheadline?: string;
  ctaText?: string;
  ctaUrl?: string;
  layout?: string;
};

const layoutClass = {
  "full-bleed": "flex flex-col items-center justify-center",
  "split-image-right": "flex flex-col-reverse md:flex-row items-center gap-8",
  "split-image-left": "flex flex-col md:flex-row items-center gap-8",
}[layout] || "flex flex-col items-center justify-center";
---

<section class={`py-20 px-4 md:px-8 ${layoutClass}`}>
  {image && (
    <img
      src={image}
      alt={headline}
      class="w-full md:w-1/2 rounded-2xl object-cover shadow-lg"
    />
  )}
  <div class="flex-1 space-y-6 text-center md:text-left">
    <h1 class="text-5xl md:text-6xl font-serif font-bold text-primary leading-tight">{headline}</h1>
    {subheadline && <p class="text-xl text-foreground/70 font-light leading-relaxed">{subheadline}</p>}
    {ctaText && ctaUrl && (
      <a
        href={ctaUrl}
        class="inline-block px-8 py-3 bg-primary text-primary-foreground rounded-xl hover:bg-primary/90 transition font-medium"
      >
        {ctaText}
      </a>
    )}
  </div>
</section>
