---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  image,
  headline,
  subheadline,
  ctaText,
  ctaUrl,
  layout = "full-bleed",
} = widget.props as {
  image?: string;
  headline: string;
  subheadline?: string;
  ctaText?: string;
  ctaUrl?: string;
  layout?: string;
};
---

<section class="relative w-full overflow-hidden">
  {image && (
    <div class="relative h-[500px] md:h-[600px] w-full overflow-hidden">
      <img
        src={image}
        alt={headline}
        class="w-full h-full object-cover"
      />
      {/* Overlay gradient */}
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent" />
    </div>
  )}

  <div class={`relative ${image ? '-mt-32 md:-mt-40 mx-4 md:mx-8' : 'py-20 px-4 md:px-8'}`}>
    <div class="max-w-2xl">
      <h1 class="text-5xl md:text-7xl font-serif font-bold text-white drop-shadow-lg leading-tight mb-4">
        {headline}
      </h1>
      {subheadline && (
        <p class="text-lg md:text-xl text-white/90 font-light leading-relaxed mb-8 drop-shadow">
          {subheadline}
        </p>
      )}
      {ctaText && ctaUrl && (
        <a
          href={ctaUrl}
          class="inline-block px-8 py-3 bg-accent text-white rounded-2xl hover:bg-accent/90 transition font-medium shadow-lg"
        >
          {ctaText}
        </a>
      )}
    </div>
  </div>
</section>
