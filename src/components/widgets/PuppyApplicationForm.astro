---
import type { WidgetInstance } from "@/lib/template-kit";

const KENNEL_ID = import.meta.env.WETNOSE_KENNEL_ID ?? "";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { mode = "embed", introText = "Apply for a puppy", ctaLabel = "Apply Now" } = widget.props as {
  mode?: "embed" | "link";
  introText?: string;
  ctaLabel?: string;
};

const applyUrl = mode === "embed" ? `/embed/apply/${KENNEL_ID}` : `/apply/${KENNEL_ID}`;
---

{
  mode === "link" ? (
    <section class="py-20 px-6">
      <div class="max-w-md mx-auto text-center">
        {introText && (
          <p class="text-lg text-foreground/80 mb-8">
            {introText}
          </p>
        )}
        <a
          href={applyUrl}
          class="inline-block bg-accent text-white px-8 py-3 rounded-full hover:bg-accent/90 transition font-medium"
        >
          {ctaLabel}
        </a>
      </div>
    </section>
  ) : (
    <section class="py-20 px-6">
      <div class="max-w-2xl mx-auto">
        {introText && (
          <p class="text-lg text-foreground/80 text-center mb-12">
            {introText}
          </p>
        )}
        <iframe
          src={applyUrl}
          title="Puppy Application Form"
          class="w-full border-0 rounded-2xl overflow-hidden"
          style={{
            minHeight: "700px",
          }}
        />
      </div>
    </section>
  )
}
