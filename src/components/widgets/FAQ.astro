---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  items = [],
  grouped = false,
} = widget.props as {
  items?: { question: string; answer: string }[];
  grouped?: boolean;
};
---

<section class="py-12 px-4 md:px-8">
  <div class="max-w-2xl mx-auto">
    <div class="space-y-3">
      {items.map((item, idx) => (
        <details key={idx} class="group border rounded-lg p-4">
          <summary class="cursor-pointer font-semibold flex justify-between items-center hover:text-primary">
            {item.question}
            <span class="transition group-open:rotate-180">▼</span>
          </summary>
          <p class="mt-3 text-muted-foreground">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
