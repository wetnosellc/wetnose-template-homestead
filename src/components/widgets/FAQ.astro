---
import type { WidgetInstance } from "@/lib/template-kit";
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  items = [],
} = widget.props as {
  items?: { question: string; answer: string }[];
};

const sanitizeOptions = {
  allowedTags: [...sanitizeHtml.defaults.allowedTags, "del", "img", "input"],
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    a: ["href", "title"],
    input: ["type", "checked", "disabled"],
    ol: ["start"],
    th: ["align"],
    td: ["align"],
  },
  transformTags: {
    input: sanitizeHtml.simpleTransform("input", { type: "checkbox", disabled: "" }),
  },
};
const renderAnswer = (answer: string) =>
  sanitizeHtml(marked.parse(answer, { async: false, gfm: true, breaks: false }), sanitizeOptions);
---

<section class="py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="space-y-0">
      {items.map((item, idx) => (
        <details
          class="group border-t border-stone-200/60 py-6 cursor-pointer"
        >
          <summary class="flex gap-6 items-start hover:text-primary transition-colors">
            {/* Number column */}
            <span class="text-2xl font-serif font-bold text-primary flex-shrink-0 w-12">
              {String(idx + 1).padStart(2, "0")}
            </span>

            {/* Question */}
            <span class="text-lg md:text-xl font-serif font-bold text-foreground flex-1">
              {item.question}
            </span>

            {/* Chevron */}
            <span class="text-primary flex-shrink-0 group-open:rotate-180 transition-transform">
              ▼
            </span>
          </summary>

          {/* Answer */}
          <div class="faq-answer text-base leading-relaxed text-foreground/80 mt-4 ml-20" set:html={renderAnswer(item.answer)} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-answer { min-width: 0; overflow-wrap: anywhere; }
  .faq-answer :global(:is(p, ul, ol, pre, blockquote, table, hr)) { margin-block: 1rem; }
  .faq-answer :global(:is(h1, h2, h3, h4, h5, h6)) {
    margin-block: 1.5rem 0.75rem;
    font-size: 1.25em;
    font-weight: 600;
  }
  .faq-answer :global(a) { color: var(--color-primary); text-decoration: underline; }
  .faq-answer :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .faq-answer :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .faq-answer :global(li + li) { margin-top: 0.375rem; }
  .faq-answer :global(li:has(> input)) { list-style: none; }
  .faq-answer :global(input) { margin-right: 0.375rem; }
  .faq-answer :global(blockquote) { border-left: 2px solid currentColor; padding-left: 1rem; }
  .faq-answer :global(code) {
    padding: 0.125em 0.25em;
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-size: 0.9em;
  }
  .faq-answer :global(pre) { overflow-x: auto; padding: 0.75rem; }
  .faq-answer :global(pre code) { padding: 0; background: none; }
  .faq-answer :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  .faq-answer :global(:is(th, td)) { border: 1px solid var(--color-border); padding: 0.375rem 0.75rem; }
  .faq-answer :global(img) { max-width: 100%; height: auto; }
  .faq-answer > :global(:first-child) { margin-top: 0; }
  .faq-answer > :global(:last-child) { margin-bottom: 0; }
</style>
