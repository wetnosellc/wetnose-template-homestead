---
import type { WidgetInstance } from "@/lib/template-kit";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  items = [],
} = widget.props as {
  items?: { question: string; answer: string }[];
};
---

<section class="py-20 px-6">
  <div class="max-w-3xl mx-auto">
    <div class="space-y-0">
      {items.map((item, idx) => (
        <details
          key={idx}
          class="group border-t border-stone-200/60 py-6 cursor-pointer"
        >
          <summary class="flex gap-6 items-start hover:text-primary transition-colors">
            {/* Number column */}
            <span class="text-2xl font-serif font-bold text-primary flex-shrink-0 w-12">
              {String(idx + 1).padStart(2, "0")}
            </span>

            {/* Question */}
            <span class="text-lg md:text-xl font-serif font-bold text-foreground flex-1">
              {item.question}
            </span>

            {/* Chevron */}
            <span class="text-primary flex-shrink-0 group-open:rotate-180 transition-transform">
              ▼
            </span>
          </summary>

          {/* Answer */}
          <p class="text-base leading-relaxed text-foreground/80 mt-4 ml-20">
            {item.answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
