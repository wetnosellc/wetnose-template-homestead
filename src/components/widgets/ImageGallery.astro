---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  items = [],
} = widget.props as {
  items?: { image: string; caption?: string }[];
};

// Asymmetric grid: cycle through column spans
const colSpans = ["md:col-span-8", "md:col-span-4", "md:col-span-5", "md:col-span-7"];
---

<section class="py-20 px-6">
  <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-4">
    {items.map((item, idx) => {
      const colSpan = colSpans[idx % colSpans.length];
      const aspectRatio = idx % 4 === 0 || idx % 4 === 2 ? "aspect-[4/3]" : "aspect-[3/4]";
      return (
        <figure key={idx} class={`${colSpan} ${aspectRatio}`}>
          <img
            src={item.image}
            alt={item.caption || "Gallery image"}
            class="w-full h-full rounded-2xl object-cover"
          />
          {item.caption && (
            <figcaption class="mt-3 text-sm italic text-foreground/60 text-center">
              {item.caption}
            </figcaption>
          )}
        </figure>
      );
    })}
  </div>
</section>
