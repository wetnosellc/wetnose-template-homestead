---
import type { WidgetInstance } from "@/lib/template-kit";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { text, size } = widget.props as { text?: string; size?: "h1" | "h2" | "h3" };

const resolvedSize = size ?? "h2";
const sizeClass = {
  h1: "text-4xl md:text-5xl",
  h2: "text-3xl md:text-4xl",
  h3: "text-2xl md:text-3xl",
}[resolvedSize];
---

{text && (
  <div class="max-w-7xl mx-auto px-4 md:px-8 pt-12 pb-2 text-center">
    {resolvedSize === "h1" && <h1 class={`font-bold text-foreground tracking-tight ${sizeClass}`}>{text}</h1>}
    {resolvedSize === "h2" && <h2 class={`font-bold text-foreground tracking-tight ${sizeClass}`}>{text}</h2>}
    {resolvedSize === "h3" && <h3 class={`font-semibold text-foreground tracking-tight ${sizeClass}`}>{text}</h3>}
  </div>
)}
