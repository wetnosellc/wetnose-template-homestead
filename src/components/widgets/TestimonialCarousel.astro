---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  items = [],
} = widget.props as {
  items?: { quote: string; attribution: string }[];
};
---

<section class="py-24 px-6">
  <div class="max-w-3xl mx-auto text-center">
    {items.length > 0 && (
      <>
        {/* Open quote glyph */}
        <div class="text-7xl font-serif text-accent leading-none mb-4">
          "
        </div>

        {/* Quote (first item) */}
        <blockquote class="text-2xl md:text-3xl font-serif italic text-foreground leading-relaxed mb-8">
          {items[0].quote}
        </blockquote>

        {/* Attribution */}
        <p class="text-sm uppercase tracking-widest text-foreground/60">
          — {items[0].attribution}
        </p>

        {/* Dot navigation */}
        {items.length > 1 && (
          <div class="flex gap-2 justify-center mt-8">
            {items.map((_, idx) => (
              <button
                key={idx}
                class="w-2 h-2 rounded-full bg-primary/50 hover:bg-primary transition"
                aria-label={`Testimonial ${idx + 1}`}
              />
            ))}
          </div>
        )}
      </>
    )}
  </div>
</section>
