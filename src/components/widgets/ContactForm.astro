---
import { fetchManifest, SITE_ID } from "../../lib/wetnose";
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { recipientEmail = "", confirmationText = "Thanks — we'll be in touch." } = widget.props as {
  recipientEmail?: string;
  confirmationText?: string;
};

// Fetch kennel contact email if not specified in widget props
let emailTo = recipientEmail;
if (!emailTo) {
  try {
    const manifest = await fetchManifest();
    emailTo = manifest.kennel?.email || "";
  } catch (err) {
    console.warn("[ContactForm] Failed to fetch kennel email:", err);
  }
}
---

<section class="py-12 px-4 md:px-8">
  <div class="max-w-2xl mx-auto">
    <form
      method="POST"
      action={`/api/v1/public/sites/${SITE_ID}/contact`}
      class="space-y-4"
    >
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none"
        />
      </div>

      <div>
        <label for="phone" class="block text-sm font-medium text-gray-700">Phone (optional)</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
        <textarea
          id="message"
          name="message"
          required
          rows={5}
          class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-500 focus:outline-none"
        ></textarea>
      </div>

      {emailTo && (
        <input type="hidden" name="recipientEmail" value={emailTo} />
      )}
      <input type="hidden" name="confirmationText" value={confirmationText} />

      <button
        type="submit"
        class="w-full rounded-md bg-blue-600 px-4 py-2 text-white font-medium hover:bg-blue-700 transition-colors"
      >
        Send
      </button>
    </form>
  </div>
</section>
