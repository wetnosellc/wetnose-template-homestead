---
import { fetchManifest, SITE_ID } from "../../lib/wetnose";
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { recipientEmail = "", confirmationText = "Thanks — we'll be in touch." } = widget.props as {
  recipientEmail?: string;
  confirmationText?: string;
};

let emailTo = recipientEmail;
if (!emailTo) {
  try {
    const manifest = await fetchManifest();
    emailTo = manifest.kennel?.email || "";
  } catch (err) {
    console.warn("[ContactForm] Failed to fetch kennel email:", err);
  }
}
---

<section class="py-20 px-6">
  <div class="max-w-xl mx-auto">
    <form
      method="POST"
      action={`/api/v1/public/sites/${SITE_ID}/contact`}
      class="space-y-8"
    >
      {/* Name */}
      <div>
        <label for="name" class="text-xs uppercase tracking-widest text-primary block mb-2">
          Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full border-0 border-b border-stone-300 bg-transparent px-0 py-3 focus:border-primary focus:ring-0 transition-colors"
        />
      </div>

      {/* Email */}
      <div>
        <label for="email" class="text-xs uppercase tracking-widest text-primary block mb-2">
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full border-0 border-b border-stone-300 bg-transparent px-0 py-3 focus:border-primary focus:ring-0 transition-colors"
        />
      </div>

      {/* Phone */}
      <div>
        <label for="phone" class="text-xs uppercase tracking-widest text-foreground/60 block mb-2">
          Phone (optional)
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          class="w-full border-0 border-b border-stone-300 bg-transparent px-0 py-3 focus:border-primary focus:ring-0 transition-colors"
        />
      </div>

      {/* Message */}
      <div>
        <label for="message" class="text-xs uppercase tracking-widest text-primary block mb-2">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows={5}
          class="w-full border-0 border-b border-stone-300 bg-transparent px-0 py-3 focus:border-primary focus:ring-0 transition-colors resize-none"
        ></textarea>
      </div>

      {emailTo && (
        <input type="hidden" name="recipientEmail" value={emailTo} />
      )}
      <input type="hidden" name="confirmationText" value={confirmationText} />

      {/* Submit */}
      <div class="pt-4">
        <button
          type="submit"
          class="bg-accent text-white px-8 py-3 rounded-full hover:bg-accent/90 transition font-medium"
        >
          Send
        </button>
      </div>
    </form>
  </div>
</section>
