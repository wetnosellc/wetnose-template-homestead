---
import { getClient, SITE_ID } from "@/lib/client";
import type { WidgetInstance } from "@/lib/template-kit";
import type { Litter } from "@wetnosellc/template-kit";
import { safeGetPublicLittersForGrid } from "@wetnosellc/template-kit";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { filter = "current", limit = 6 } = widget.props as {
  filter?: "current" | "past" | "all" | "planned";
  limit?: number;
};

// Public, salesStatus-free fetch — litter-level availability only.
const litters: Litter[] = await safeGetPublicLittersForGrid(getClient(), SITE_ID, {
  filter: (filter as "current" | "past" | "all" | "planned"),
  maxItems: typeof limit === "number" && limit > 0 ? limit : 6,
});
---

{
  litters.length === 0 ? (
    <section class="py-12 px-6">
      <div class="text-center text-foreground/60">No litters to display.</div>
    </section>
  ) : (
    <section class="py-20 px-6">
      <div class="max-w-4xl mx-auto">
        <style>
          .timeline-line {
            position: absolute;
            left: 60px;
            top: 0;
            bottom: 0;
            width: 1px;
            background-color: var(--color-stone-300, #d4af37);
          }
          .timeline-dot {
            position: absolute;
            left: 48px;
            width: 24px;
            height: 24px;
            background-color: var(--color-accent);
            border-radius: 50%;
            margin-top: 3px;
          }
        </style>
        <div class="relative">
          <div class="timeline-line"></div>
          {litters.map((litter, idx) => {
            const dateStr = litter.birthDate
              ? litter.birthDate.toLocaleDateString("en-US", {
                  month: "short",
                  year: "numeric",
                })
              : litter.breeding ? "Upcoming" : "—";

            return (
              <div class="grid grid-cols-[120px_24px_1fr] gap-6 pb-16 last:pb-0" key={idx}>
                {/* Date column */}
                <div class="text-sm uppercase tracking-widest text-foreground/60 pt-0.5 text-right">
                  {dateStr}
                </div>

                {/* Timeline dot */}
                <div class="timeline-dot"></div>

                {/* Content column */}
                <div>
                  <h3 class="text-2xl md:text-3xl font-serif font-bold text-primary mb-2">
                    {litter.litterName || "Litter"}
                  </h3>
                  {litter.sire && litter.dam && (
                    <p class="text-sm text-foreground/60 mb-3">
                      {litter.sire.callName || litter.sire.registeredName} × {litter.dam.callName || litter.dam.registeredName}
                    </p>
                  )}
                  {litter.availability && litter.availability.total > 0 && (
                    <p class="text-base text-foreground/80 leading-relaxed">
                      {litter.availability.total} available
                    </p>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}
