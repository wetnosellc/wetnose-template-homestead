---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  headline,
  body,
  ctaText,
  ctaUrl,
} = widget.props as {
  headline: string;
  body?: string;
  ctaText: string;
  ctaUrl: string;
};
---

<section class="py-24 px-6 bg-primary/5">
  <div class="max-w-md mx-auto text-center">
    {/* Kicker */}
    <div class="text-xs uppercase tracking-widest text-primary mb-4">
      Get in touch
    </div>

    {/* Headline */}
    <h2 class="text-4xl md:text-5xl font-serif font-bold text-foreground mb-4">
      {headline}
    </h2>

    {/* Body */}
    {body && (
      <p class="text-foreground/70 mb-8">
        {body}
      </p>
    )}

    {/* CTA */}
    <a
      href={ctaUrl}
      class="inline-block bg-accent text-white px-8 py-3 rounded-full hover:bg-accent/90 transition font-medium"
    >
      {ctaText}
    </a>
  </div>
</section>
