---
import type { WidgetInstance } from "@wetnose/shared";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const {
  headline,
  body,
  ctaText,
  ctaUrl,
  background = { kind: "color", value: "bg-accent" },
} = widget.props as {
  headline: string;
  body?: string;
  ctaText: string;
  ctaUrl: string;
  background?: { kind: "color" | "image"; value: string };
};

const bgClass = background.kind === "image"
  ? `bg-cover bg-center`
  : background.value;
---

<section
  class={`py-16 px-4 md:px-8 ${bgClass} text-white rounded-2xl mx-4 md:mx-8 my-8`}
  style={background.kind === "image" ? `background-image: url(${background.value})` : undefined}
>
  <div class="max-w-2xl mx-auto text-center">
    <h2 class="text-4xl md:text-5xl font-serif font-bold mb-4">{headline}</h2>
    {body && <p class="text-lg mb-8 opacity-90">{body}</p>}
    <a
      href={ctaUrl}
      class="inline-block px-8 py-3 bg-white text-accent rounded-xl hover:bg-white/90 transition font-semibold"
    >
      {ctaText}
    </a>
  </div>
</section>
