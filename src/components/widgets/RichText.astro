---
import { marked } from "marked";
import type { WidgetInstance } from "@/lib/template-kit";

interface Props {
  widget: WidgetInstance;
}

const { widget } = Astro.props;
const { markdown = "" } = widget.props as { markdown?: string };

console.log(`[RichText] widget.type=${widget.type}, markdown length=${markdown.length}, markdown="${markdown.substring(0, 50)}..."`);

const html = await marked(markdown);
---

<section class="py-16 px-4 md:px-8">
  <style>
    :global(.richtext-content) h1 {
      font-family: var(--font-serif);
      font-weight: 700;
      color: var(--color-primary);
      margin-top: 2rem;
      margin-bottom: 1rem;
      line-height: 1.25;
      font-size: 2.25rem;
    }
    @media (min-width: 768px) {
      :global(.richtext-content) h1 {
        font-size: 3rem;
      }
    }
    :global(.richtext-content) h2 {
      font-family: var(--font-serif);
      font-weight: 700;
      color: var(--color-primary);
      margin-top: 2rem;
      margin-bottom: 1rem;
      line-height: 1.33;
      font-size: 1.875rem;
    }
    @media (min-width: 768px) {
      :global(.richtext-content) h2 {
        font-size: 2.25rem;
      }
    }
    :global(.richtext-content) h3 {
      font-family: var(--font-serif);
      font-weight: 700;
      color: var(--color-primary);
      margin-top: 1.5rem;
      margin-bottom: 0.75rem;
      font-size: 1.5rem;
    }
    :global(.richtext-content) p {
      font-size: 1rem;
      line-height: 1.625;
      color: color-mix(in oklch, var(--color-foreground) 80%, transparent);
      margin-bottom: 1rem;
    }
    :global(.richtext-content) ul, :global(.richtext-content) ol {
      margin-left: 1.5rem;
      margin-bottom: 1rem;
    }
    :global(.richtext-content) ul > li, :global(.richtext-content) ol > li {
      margin-bottom: 0.5rem;
    }
    :global(.richtext-content) li {
      font-size: 1rem;
      color: color-mix(in oklch, var(--color-foreground) 80%, transparent);
    }
    :global(.richtext-content) a {
      color: var(--color-primary);
      text-decoration: none;
      transition: text-decoration 0.15s;
    }
    :global(.richtext-content) a:hover {
      text-decoration: underline;
    }
    :global(.richtext-content) blockquote {
      border-left: 4px solid color-mix(in oklch, var(--color-primary) 30%, transparent);
      padding-left: 1rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      font-style: italic;
      color: color-mix(in oklch, var(--color-foreground) 70%, transparent);
      margin-bottom: 1rem;
    }
  </style>
  <div class="richtext-content max-w-2xl mx-auto" set:html={html} />
</section>
