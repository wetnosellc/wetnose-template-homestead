---
import type { WidgetInstance } from "@/lib/template-kit";
import Hero from "./widgets/Hero.astro";
import RichText from "./widgets/RichText.astro";
import ImageGallery from "./widgets/ImageGallery.astro";
import TestimonialCarousel from "./widgets/TestimonialCarousel.astro";
import FAQ from "./widgets/FAQ.astro";
import CTAStrip from "./widgets/CTAStrip.astro";
import DogsGrid from "./widgets/DogsGrid.astro";
import LittersGrid from "./widgets/LittersGrid.astro";
import ContactForm from "./widgets/ContactForm.astro";
import PuppyApplicationForm from "./widgets/PuppyApplicationForm.astro";
import CardGrid from "./widgets/CardGrid.astro";
import SectionHeading from "./widgets/SectionHeading.astro";

interface Props {
  widgets: WidgetInstance[];
}

const { widgets } = Astro.props;

const widgetComponents: Record<string, any> = {
  hero: Hero,
  richtext: RichText,
  "image-gallery": ImageGallery,
  "testimonial-carousel": TestimonialCarousel,
  faq: FAQ,
  "cta-strip": CTAStrip,
  "dogs-grid": DogsGrid,
  "litters-grid": LittersGrid,
  "contact-form": ContactForm,
  "puppy-application-form": PuppyApplicationForm,
  "card-grid": CardGrid,
  "section-heading": SectionHeading,
};
---

{
  widgets.map((widget) => {
    const Component = widgetComponents[widget.type];
    if (!Component) {
      return <div class="p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">Unknown widget type: {widget.type}</div>;
    }
    return <Component widget={widget} />;
  })
}
