---
import StatusPill from '@/components/StatusPill.astro';
import type { Dog } from '@wetnosellc/template-kit';

interface Props {
  dog: Dog;
  slug: string;
}

const { dog, slug } = Astro.props;
const titles = dog.titles;
const healthClearances = dog.healthClearances;

function ageFromBirthDate(birthDate: Date | null, dateOfDeath?: Date | null): string {
  if (!birthDate) return '';
  const birth = birthDate;
  const end = dateOfDeath ?? new Date();
  const diffYears = (end.getTime() - birth.getTime()) / (1000 * 60 * 60 * 24 * 365.25);
  if (diffYears < 1) {
    const months = Math.floor(diffYears * 12);
    return months <= 1 ? '1 month' : `${months} months`;
  }
  const years = Math.floor(diffYears);
  return years === 1 ? '1 year' : `${years} years`;
}

const age = ageFromBirthDate(dog.birthDate, dog.dateOfDeath);

type StatusPillVariant = 'active' | 'for-sale' | 'stud' | 'retired' | 'frozen-semen' | 'available' | 'reserved' | 'male' | 'female' | 'current' | 'upcoming' | 'planned' | 'sold-out' | 'past';

function statusVariant(dog: Dog): StatusPillVariant {
  if (dog.forSale) return 'for-sale';
  if (dog.statuses.some(s => s.name === 'Retired' || s.name === 'Historical')) return 'retired';
  if (dog.studServiceAvailable) return 'stud';
  if (dog.frozenSemenAvailable) return 'frozen-semen';
  return 'active';
}

const pillVariant = statusVariant(dog);
const sexVariant: StatusPillVariant = dog.sex === 'M' ? 'male' : 'female';

const titleChips = titles.slice(0, 5).map(t => t.titleShortname ?? t.titleName ?? '');
const healthChips = healthClearances.slice(0, 5).map(h => h.testName ?? '');

const sizeStr = [dog.weight ? `${dog.weight} lb` : null, dog.height ? `${dog.height} in` : null].filter(Boolean).join(' · ');
---

<a
  href={`/dogs/${slug}`}
  class="flex flex-col bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow overflow-hidden border border-border group"
>
  {dog.thumbnailPhotoUrl ? (
    <img
      src={dog.thumbnailPhotoUrl}
      alt={dog.name}
      class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
    />
  ) : (
    <div class="w-full h-64 bg-stone-100 flex items-center justify-center text-muted-foreground text-sm">
      No photo
    </div>
  )}

  <div class="p-5 flex flex-col flex-1">
    <!-- Name first, then pills (matches Figma layout) -->
    <h3 class="text-xl font-bold text-foreground leading-tight mb-2">
      {dog.name}
    </h3>

    <div class="flex flex-wrap gap-1.5 mb-2">
      <StatusPill variant={sexVariant} />
      <StatusPill variant={pillVariant} />
      {dog.frozenSemenAvailable && pillVariant !== 'frozen-semen' && (
        <StatusPill variant="frozen-semen" />
      )}
    </div>

    {dog.callName && (
      <p class="text-xs text-muted-foreground mb-3 truncate">{dog.registeredName}</p>
    )}

    {(age || sizeStr) && (
      <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted-foreground mb-3">
        {age && (
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Age {age}
          </span>
        )}
        {sizeStr && (
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 6H3"/>
              <path d="M21 12H3"/>
              <path d="M21 18H3"/>
            </svg>
            Size {sizeStr}
          </span>
        )}
      </div>
    )}

    {titleChips.length > 0 && (
      <div class="mb-2">
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1">
          Accomplishments ({titles.length})
        </p>
        <div class="flex flex-wrap gap-1">
          {titleChips.map(chip => (
            <span class="text-xs px-2 py-0.5 bg-amber-50 border border-amber-200 rounded-full text-amber-800">{chip}</span>
          ))}
          {titles.length > 5 && (
            <span class="text-xs px-2 py-0.5 bg-secondary rounded-full text-muted-foreground">+{titles.length - 5} more</span>
          )}
        </div>
      </div>
    )}

    {healthChips.length > 0 && (
      <div class="mb-4">
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1">
          Health Tests ({healthClearances.length})
        </p>
        <div class="flex flex-wrap gap-1">
          {healthChips.map(chip => (
            <span class="text-xs px-2 py-0.5 bg-teal-50 border border-teal-200 rounded-full text-teal-800">{chip}</span>
          ))}
          {healthClearances.length > 5 && (
            <span class="text-xs px-2 py-0.5 bg-secondary rounded-full text-muted-foreground">+{healthClearances.length - 5} more</span>
          )}
        </div>
      </div>
    )}

    <div class="mt-auto">
      <span class="block w-full text-center bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">
        Talk to Family
      </span>
    </div>
  </div>
</a>
