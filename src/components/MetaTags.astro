---
import type { PageMeta } from '@wetnosellc/template-kit';

interface Props {
  meta: PageMeta;
  jsonLd?: object | object[];
}

const { meta, jsonLd } = Astro.props;
const jsonLdArr = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// CMS-sourced strings (kennel name, bios, addresses, ...) can flow into
// JSON-LD values. Escape `<`, `>`, and `&` as unicode escapes so a value
// containing `</script>` or similar can't break out of the inline script tag.
const toSafeJsonLd = (value: object): string =>
  JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');
---
<title>{meta.title}</title>
{meta.description && <meta name="description" content={meta.description} />}
<link rel="canonical" href={meta.canonicalUrl} />
{meta.robots && <meta name="robots" content={meta.robots} />}

<meta property="og:type" content={meta.openGraph.type} />
<meta property="og:title" content={meta.openGraph.title} />
<meta property="og:description" content={meta.openGraph.description} />
<meta property="og:url" content={meta.openGraph.url} />
<meta property="og:site_name" content={meta.openGraph.siteName} />
{meta.openGraph.image && <meta property="og:image" content={meta.openGraph.image} />}

<meta name="twitter:card" content={meta.twitter.card} />
<meta name="twitter:title" content={meta.twitter.title} />
<meta name="twitter:description" content={meta.twitter.description} />
{meta.twitter.image && <meta name="twitter:image" content={meta.twitter.image} />}

{jsonLdArr.map((ld) => (
  <script is:inline type="application/ld+json" set:html={toSafeJsonLd(ld)} />
))}
